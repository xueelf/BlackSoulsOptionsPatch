<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BlackSoulsQoLPatch</AssemblyName>
    <Company>Yuki</Company>
    <Product>Black Souls QoL Patch</Product>
    <Copyright>Copyright © 2026 Yuki &lt;admin@yuki.sh&gt;</Copyright>
    <ApplicationIcon>..\assets\BlackSoulsQoLPatch.ico</ApplicationIcon>
    <RootNamespace>OptionsPatch</RootNamespace>
    <AssemblyTitle>An unofficial QoL patch for BLACK SOULS and BLACK SOULS II.</AssemblyTitle>
    <BuildDate>$([System.DateTime]::Now.ToString("yyyy.MM.dd"))</BuildDate>
    <Version>$(BuildDate)</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="options.rb">
      <LogicalName>options.rb</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\Cover.png">
      <LogicalName>Cover.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\locales\installer\*.json">
      <LogicalName>locale.installer.%(Filename).json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\locales\game\*.json">
      <LogicalName>locale.game.%(Filename).json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
